# Copie este archivo como ".env" y complete los valores.
# El archivo ".env" NUNCA se sube a git (está en .gitignore).

# Servidor
NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL (la creada para el proyecto)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=candray_mockup
DB_USER=candray_user
DB_PASSWORD=

# Firma de los tokens de sesión: mínimo 32 caracteres, aleatorios.
# Para generar uno:  openssl rand -hex 32
JWT_SECRET=

# Costo del cifrado de contraseñas (bcrypt). 10 es un buen valor.
BCRYPT_ROUNDS=10

# Perfil de permisos: "demostracion" (el administrador ve todo)
# o "estricto" (el administrador no accede a datos clínicos).
PERFIL_PERMISOS=demostracion

# Opcional: intentos de inicio de sesión por IP antes de bloquear.
# Si se omite: 5 en producción y 100 en desarrollo.
# AUTH_RATE_LIMIT_MAX=
